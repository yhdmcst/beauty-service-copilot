# Local demo configuration. No cloud credentials are required.
QWEN_PROVIDER=ollama
QWEN_API_BASE=http://127.0.0.1:11434/v1
QWEN_MODEL_SMALL=qwen3:8b
QWEN_MODEL_LARGE=qwen3:8b
QWEN_THINKING=false
QWEN_TIMEOUT_SECONDS=60
QWEN_MAX_ATTEMPTS=1

# Offline lexical retrieval and process-local cache.
VECTOR_BACKEND=memory
EMBEDDING_BACKEND=local
CACHE_BACKEND=local

# Optional Redis/Qdrant connection settings.
REDIS_HOST=localhost
REDIS_PORT=6379
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=beauty_knowledge

# Leave rates at zero unless an actual priced provider is configured.
QWEN_7B_INPUT_CNY_PER_M=0
QWEN_7B_OUTPUT_CNY_PER_M=0
QWEN_72B_INPUT_CNY_PER_M=0
QWEN_72B_OUTPUT_CNY_PER_M=0

# Optional cloud use must be explicitly configured in your private .env.
# QWEN_PROVIDER=openai
# QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_API_KEY=replace_with_your_private_key
# QWEN_MODEL_SMALL=your_provider_model
# QWEN_MODEL_LARGE=your_provider_model
